[
  {
    "description": "Search the local corpus by keyword, regular expression or ranked citable passages.",
    "inputSchema": {
      "oneOf": [
        {
          "properties": {
            "mode": {
              "enum": [
                "keyword"
              ]
            }
          },
          "required": [
            "query"
          ]
        },
        {
          "anyOf": [
            {
              "required": [
                "query"
              ]
            },
            {
              "required": [
                "seed"
              ]
            }
          ],
          "properties": {
            "mode": {
              "enum": [
                "passages"
              ]
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "properties": {
            "mode": {
              "enum": [
                "regex"
              ]
            }
          },
          "required": [
            "pattern"
          ]
        }
      ],
      "properties": {
        "field": {
          "default": "text",
          "enum": [
            "text",
            "title",
            "author",
            "year"
          ],
          "type": "string"
        },
        "intent": {
          "enum": [
            "topic",
            "quotation",
            "parallel"
          ]
        },
        "library_wide": {
          "default": false,
          "type": "boolean"
        },
        "mode": {
          "default": "keyword",
          "enum": [
            "keyword",
            "regex",
            "passages"
          ],
          "type": "string"
        },
        "paper_id": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "seed": {
          "properties": {
            "node_id": {
              "type": "string"
            },
            "source_id": {
              "type": "string"
            }
          },
          "required": [
            "source_id",
            "node_id"
          ],
          "type": "object"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "top_k": {
          "default": 20,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "name": "shutong_search"
  },
