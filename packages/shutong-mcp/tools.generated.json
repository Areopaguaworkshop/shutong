  {
    "description": "Run paper-scoped concordance, collocations, contextual sentiment evidence, exact quotation checks or source text reuse; retrieve, annotate and review saved provenance records.",
    "inputSchema": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "action": {
              "const": "run"
            }
          },
          "required": [
            "mode",
            "language",
            "question",
            "source_ids"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "get"
            }
          },
          "required": [
            "analysis_id"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "annotate"
            }
          },
          "required": [
            "analysis_id",
            "record_sha256",
            "model_id",
            "annotations"
          ]
        },
        {
          "properties": {
            "action": {
              "const": "review"
            }
          },
          "required": [
            "analysis_id",
            "record_sha256",
            "outcome",
            "evidence",
            "reviewer"
          ]
        }
      ],
      "properties": {
        "action": {
          "enum": [
            "run",
            "get",
            "annotate",
            "review"
          ]
        },
        "analysis_id": {
          "pattern": "^analysis-[a-f0-9]{32}$",
          "type": "string"
        },
        "annotations": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "context": {
          "maximum": 1000,
          "minimum": 20,
          "type": "integer"
        },
        "evidence": {
          "type": "string"
        },
        "language": {
          "enum": [
            "en",
            "zh"
          ]
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "minimum_tokens": {
          "maximum": 30,
          "minimum": 4,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "concordance",
            "collocations",
            "contextual_sentiment",
            "quotation",
            "text_reuse"
          ]
        },
        "model_id": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "pass",
            "fail",
            "uncertain"
          ]
        },
        "paper_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "reviewer": {
          "type": "string"
        },
        "rubric": {
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "window": {
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "action",
        "paper_id"
      ],
      "type": "object"
    },
    "name": "shutong_analysis"
  }
]
